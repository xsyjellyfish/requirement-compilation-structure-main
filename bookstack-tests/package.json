{
  "name": "arc-bench-bookstack-tests",
  "private": true,
  "description": "Standalone ARC-Bench BookStack acceptance environment (official requirements + official Playwright tests).",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:acceptance": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-bookstack-tests.ps1",
    "test:e2e:analyze": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/analyze-bookstack-failures.ps1",
    "generate:app": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/generate-bookstack-app.ps1",
    "verify": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-official-tests.ps1"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0"
  }
}
